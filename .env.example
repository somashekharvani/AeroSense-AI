# ==============================================================================
# AeroSense AI — Environment Variables Template
# Server-only keys (Never expose to client-side bundles unless prefixed with NEXT_PUBLIC_)
# ==============================================================================

# Google Gemini API Key (Gemini 2.5 Flash SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WAQI (World Air Quality Index) Token for CPCB Ground Station Telemetry
WAQI_TOKEN=

# NASA FIRMS Map Key for VIIRS NRT Satellite Active Fire Points
FIRMS_MAP_KEY=

# AeroSense Drone Hardware Ingestion Shared Key (REST API /api/drone/ingest)
DRONE_INGEST_API_KEY=

# MapLibre Vector Tile Style URL (Client-safe tile configuration)
NEXT_PUBLIC_MAP_TILE_URL=https://demotiles.maplibre.org/style.json
