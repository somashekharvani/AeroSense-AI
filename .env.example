# AeroSense AI - Environment Variables
# Server-only keys (never expose to client-side bundles)

# Google Gemini API (Phase 4)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# WAQI Token for Ground Station Feeds (Phase 3)
WAQI_TOKEN="your-waqi-token"

# NASA FIRMS Map Key for Active Satellite Fire Points (Phase 3)
FIRMS_MAP_KEY="your-firms-map-key"

# Optional Drone Hardware Ingestion Key (Phase 7)
DRONE_INGEST_API_KEY="your-drone-secret-key"

# MapLibre Vector Tile URL (Phase 3/5)
NEXT_PUBLIC_MAP_TILE_URL="https://demotiles.maplibre.org/style.json"
